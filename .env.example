NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ntt_marketplace
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_NAME=ntt_marketplace_sid
SESSION_MAX_AGE_MS=604800000
# 0/false khi chạy trực tiếp; đặt số hop proxy tin cậy khi deploy sau reverse proxy.
TRUST_PROXY=0
# Optional for mongodb+srv DNS lookup issues:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
