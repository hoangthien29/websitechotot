<%- include('../partials/header', { pageStyles: ['/css/messages.css'] }) %>

<section class="messages-page messages-page--redesign">
  <div class="container messages-container">

    <div class="messages-shell">

      <!-- CHAT CONTENT -->
      <main
        id="chat-panel"
        class="messages-content-panel"
        aria-live="polite"
      >

        <div class="messages-content-panel__empty">
          <h2>Chọn một cuộc trò chuyện</h2>
          <p>Nội dung chat sẽ hiển thị tại đây.</p>
        </div>

      </main>

      <!-- CONVERSATION LIST -->
      <aside class="messages-sidebar" aria-label="Danh sách trò chuyện">

        <div class="messages-sidebar__header">
          <h2>Trò chuyện</h2>
          <span><%= totalItems %> mục</span>
        </div>

        <div class="conversation-redesign-list">

          <% conversations.forEach((conversation) => { %>

            <article
              class="conversation-redesign-card"
              data-conversation
              data-conversation-id="<%= conversation.id %>"
            >

              <div class="conversation-redesign-row">

                <a
                  class="conversation-redesign-avatar-link"
                  href="<%= conversation.otherParticipant.id ? '/users/' + conversation.otherParticipant.id : '#' %>"
                  aria-label="Xem trang cá nhân của <%= conversation.otherParticipant.name %>"
                >
                  <img
                    class="conversation-redesign-avatar"
                    src="<%= conversation.otherParticipant.avatarUrl %>"
                    width="44"
                    height="44"
                    alt=""
                  >
                </a>

                <a
                  class="conversation-redesign-link"
                  href="#"
                  data-id="<%= conversation.id %>"
                  aria-label="Mở trò chuyện với <%= conversation.otherParticipant.name %>"
                >
                  <div class="conversation-redesign-user__copy">
                    <div class="conversation-redesign-user__line">
                      <h2><%= conversation.otherParticipant.name %></h2>
                      <time class="conversation-redesign-time"><%= conversation.formattedLastMessageAt %></time>
                    </div>

                    <p class="conversation-redesign-preview"><%= conversation.lastMessagePreview %></p>
                  </div>
                </a>

                <% if (conversation.unreadCount > 0) { %>
                  <span class="conversation-redesign-unread">
                    <%= conversation.unreadCount > 99 ? '99+' : conversation.unreadCount %>
                  </span>
                <% } %>

              </div>

            </article>

          <% }) %>

        </div>

      </aside>

    </div>

  </div>
</section>

<script src="/js/messager.js"></script>

<%- include('../partials/footer') %>