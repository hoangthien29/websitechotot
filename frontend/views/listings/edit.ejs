<%- include('../partials/header', { pageStyles: ['/css/listing-form.css'] }) %>
<section class="listing-editor-page">

  <div class="container">

    <div class="listing-editor-header">

      <a
        class="listing-editor-back"
        href="/listings/<%= listing._id %>"
        aria-label="Quay lại chi tiết sản phẩm"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>

        <span>
          Quay lại
        </span>

      </a>


      <div class="listing-editor-heading">
        <h1>
          Chỉnh sửa bài đăng
        </h1>
      </div>

    </div>


    <%- include('_form', {

      formAction:
        '/listings/' +
        listing._id +
        '?_method=PUT',

      submitLabel:
        'Lưu thay đổi',

      cancelUrl:
        '/listings/' +
        listing._id,

      canSubmit:
        true,

      categories,

      errors,

      oldInput,

      existingImages,

      maxImages,

      remainingImageSlots,

      retryImages,

      selectedRemoveImages,

      isEdit: true

    }) %>

  </div>

</section>


<script
  src="/js/listing-form.js"
  defer
></script>

<%- include('../partials/footer') %>