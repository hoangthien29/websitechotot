<form
  class="listing-editor-form"
  action="<%= formAction %>"
  method="POST"
  enctype="multipart/form-data"
  data-listing-editor-form
  data-max-images="<%= maxImages %>"
  data-existing-images="<%= existingImages.length %>"
  data-can-submit="<%= canSubmit ? 'true' : 'false' %>"
>
  <%- include('../partials/csrf') %>

  <section class="listing-editor-section" aria-labelledby="listing-images-title">
    <div class="listing-editor-section__head">
      <span class="listing-editor-step" aria-hidden="true">1</span>
      <div>
        <h2 id="listing-images-title">Hình ảnh sản phẩm</h2>
        <p>Thêm tối đa <%= maxImages %> ảnh. Ảnh đầu tiên sẽ được dùng làm ảnh đại diện.</p>
      </div>
    </div>

    <% if (errors.images) { %>
      <div class="listing-editor-field-error" role="alert"><%= errors.images %></div>
    <% } %>

    <% if (existingImages.length > 0) { %>
      <div class="listing-existing-images">
        <div class="listing-existing-images__head">
          <div>
            <h3>Ảnh hiện tại</h3>
            <p>Chọn “Xóa ảnh” nếu bạn không muốn giữ ảnh đó sau khi lưu.</p>
          </div>
          <span class="listing-image-count"><%= existingImages.length %>/<%= maxImages %> ảnh</span>
        </div>

        <div class="listing-existing-grid">
          <% existingImages.forEach((imagePath, index) => { %>
            <% const selected = selectedRemoveImages.includes(imagePath); %>
            <label class="listing-existing-card <%= selected ? 'is-selected-for-removal' : '' %>" data-existing-image-card>
              <img src="<%= imagePath %>" alt="Ảnh sản phẩm hiện tại <%= index + 1 %>" width="800" height="600" loading="lazy">
              <% if (index === 0) { %>
                <span class="listing-existing-card__primary">Ảnh chính</span>
              <% } %>
              <span class="listing-existing-card__remove">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="removeImages"
                  value="<%= imagePath %>"
                  data-remove-existing-image
                  <%= selected ? 'checked' : '' %>
                <span>Xóa ảnh</span>
              </span>
            </label>
          <% }); %>
        </div>
      </div>
    <% } %>
    <div class="listing-upload-block">

      <!-- INPUT THẬT - GIỮ NAME images ĐỂ BACKEND CŨ VẪN HOẠT ĐỘNG -->
      <input
        class="listing-upload-input-hidden"
        id="images"
        name="images"
        type="file"
        accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
        multiple
        data-listing-image-input
      >


      <!-- 5 Ô ẢNH -->
      <div
        class="listing-image-slots"
        data-image-slots
      >

        <% for (let slotIndex = 0; slotIndex < 5; slotIndex += 1) { %>

          <button
            class="
              listing-image-slot
              <%= slotIndex === 0
                ? 'listing-image-slot--primary'
                : ''
              %>
            "
            type="button"
            data-image-slot="<%= slotIndex %>"
          >

            <!-- PREVIEW -->
            <img
              class="listing-image-slot__preview"
              data-image-slot-preview
              alt=""
              hidden
            >


            <!-- PLACEHOLDER -->
            <span
              class="listing-image-slot__placeholder"
              data-image-slot-placeholder
            >

              <span class="listing-image-slot__icon">

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >

                  <rect
                    x="3"
                    y="3"
                    width="18"
                    height="18"
                    rx="3"
                  ></rect>

                  <circle
                    cx="8.5"
                    cy="8.5"
                    r="1.5"
                  ></circle>

                  <path d="m21 15-5-5L5 21"></path>

                  <path d="M12 7v6"></path>

                  <path d="M9 10h6"></path>

                </svg>

              </span>


              <strong>
                Ảnh <%= slotIndex + 1 %>
              </strong>


              <% if (slotIndex === 0) { %>

                <small>
                  Ảnh đại diện
                </small>

              <% } else { %>

                <small>
                  Thêm ảnh
                </small>

              <% } %>

            </span>


            <!-- NHÃN KHI ĐÃ CÓ ẢNH -->
            <span
              class="listing-image-slot__number"
              data-image-slot-number
              hidden
            >
              <%= slotIndex === 0
                ? 'Ảnh 1 · Đại diện'
                : `Ảnh ${slotIndex + 1}`
              %>
            </span>


            <!-- NÚT XÓA -->
            <span
              class="listing-image-slot__remove"
              data-image-slot-remove
              role="button"
              tabindex="0"
              aria-label="Xóa ảnh"
              hidden
            >
              ×
            </span>

          </button>

        <% } %>

      </div>


      <div class="listing-upload-meta">

        <span data-image-slot-text>
          Có thể đăng tối đa 5 ảnh.
        </span>

        <span data-selected-image-count>
          Chưa chọn ảnh
        </span>

      </div>


      <p
        class="listing-upload-client-error"
        data-image-client-error
        aria-live="polite"
      ></p>
    </div>

    <% if (retryImages) { %>
      <div class="alert alert-warning mb-0" role="alert">
        Các file vừa chọn không được giữ lại sau khi form báo lỗi. Vui lòng chọn lại ảnh trước khi gửi.
      </div>
    <% } %>
  </section>

  <section class="listing-editor-section" aria-labelledby="listing-basic-title">
    <div class="listing-editor-section__head">
      <span class="listing-editor-step" aria-hidden="true">2</span>
      <div>
        <h2 id="listing-basic-title">Thông tin sản phẩm</h2>
        <p>Tiêu đề ngắn gọn và đúng sản phẩm sẽ giúp tin dễ được tìm thấy hơn.</p>
      </div>
    </div>

    <div class="listing-editor-fields">
      <div class="listing-editor-field listing-editor-field--full">
        <div class="listing-editor-label-row">
          <label for="title">Tiêu đề</label>
          <span class="listing-editor-counter" data-title-counter><%= oldInput.title.length %>/150</span>
        </div>
        <input
          class="form-control<%= errors.title ? ' is-invalid' : '' %>"
          id="title"
          name="title"
          type="text"
          value="<%= oldInput.title %>"
          minlength="5"
          maxlength="150"
          placeholder="Ví dụ: iPhone 13 128GB còn đẹp"
          aria-invalid="<%= errors.title ? 'true' : 'false' %>"
          aria-describedby="titleError"
          data-title-input
          required
        >
        <div class="invalid-feedback" id="titleError"><%= errors.title || '' %></div>
      </div>

      <div class="listing-editor-field">
        <label for="category">Danh mục</label>
        <select
          class="form-select<%= errors.category ? ' is-invalid' : '' %>"
          id="category"
          name="category"
          aria-invalid="<%= errors.category ? 'true' : 'false' %>"
          aria-describedby="categoryError"
          required
        >
          <option value="">Chọn danh mục</option>
          <% categories.forEach((category) => { %>
            <option
              value="<%= category._id %>"
              <%= oldInput.category === category._id.toString() ? 'selected' : '' %>
              <%= category.status !== 'active' ? 'disabled' : '' %>
            >
              <%= category.name %><%= category.status !== 'active' ? ' (Không hoạt động)' : '' %>
            </option>
          <% }); %>
        </select>
        <div class="invalid-feedback" id="categoryError"><%= errors.category || '' %></div>
      </div>

      <div class="listing-editor-field">
        <label for="condition">Tình trạng</label>
        <select
          class="form-select<%= errors.condition ? ' is-invalid' : '' %>"
          id="condition"
          name="condition"
          aria-invalid="<%= errors.condition ? 'true' : 'false' %>"
          aria-describedby="conditionError"
          required
        >
          <option value="used"<%= oldInput.condition === 'used' ? ' selected' : '' %>>Đã sử dụng</option>
          <option value="new"<%= oldInput.condition === 'new' ? ' selected' : '' %>>Mới</option>
        </select>
        <div class="invalid-feedback" id="conditionError"><%= errors.condition || '' %></div>
      </div>
    </div>
  </section>

  <section class="listing-editor-section" aria-labelledby="listing-sale-title">
    <div class="listing-editor-section__head">
      <span class="listing-editor-step" aria-hidden="true">3</span>
      <div>
        <h2 id="listing-sale-title">Giá bán và địa điểm</h2>
        <p>Nhập giá bán và khu vực hiện đang có sản phẩm.</p>
      </div>
    </div>

    <div class="listing-editor-fields">
      <div class="listing-editor-field">
        <label for="price">Giá bán</label>
        <div class="listing-price-control">
          <input
            class="form-control<%= errors.price ? ' is-invalid' : '' %>"
            id="price"
            name="price"
            type="number"
            value="<%= oldInput.price %>"
            min="0"
            max="100000000000"
            step="1"
            placeholder="0"
            aria-invalid="<%= errors.price ? 'true' : 'false' %>"
            aria-describedby="priceError pricePreview"
            data-price-input
            required
          >
          <span class="listing-price-control__suffix">VNĐ</span>
        </div>
        <div class="invalid-feedback <%= errors.price ? 'd-block' : '' %>" id="priceError"><%= errors.price || '' %></div>
        <small class="listing-price-preview" id="pricePreview" data-price-preview></small>
      </div>

      <div class="listing-editor-field">
        <label for="location">Địa điểm</label>
        <input
          class="form-control<%= errors.location ? ' is-invalid' : '' %>"
          id="location"
          name="location"
          type="text"
          value="<%= oldInput.location %>"
          minlength="2"
          maxlength="150"
          placeholder="Ví dụ: Quận 4, TP.HCM"
          aria-invalid="<%= errors.location ? 'true' : 'false' %>"
          aria-describedby="locationError"
          required
        >
        <div class="invalid-feedback" id="locationError"><%= errors.location || '' %></div>
      </div>
    </div>
  </section>

  <section class="listing-editor-section" aria-labelledby="listing-description-title">
    <div class="listing-editor-section__head">
      <span class="listing-editor-step" aria-hidden="true">4</span>
      <div>
        <h2 id="listing-description-title">Mô tả chi tiết</h2>
        <p>Mô tả tình trạng thực tế, phụ kiện đi kèm và thông tin người mua cần biết.</p>
      </div>
    </div>

    <div class="listing-editor-field listing-editor-field--full">
      <div class="listing-editor-label-row">
        <label for="description">Mô tả</label>
        <span class="listing-editor-counter" data-description-counter><%= oldInput.description.length %>/3000</span>
      </div>
      <textarea
        class="form-control listing-description-input<%= errors.description ? ' is-invalid' : '' %>"
        id="description"
        name="description"
        rows="8"
        minlength="20"
        maxlength="3000"
        placeholder="Mô tả rõ tình trạng sản phẩm, thời gian sử dụng, phụ kiện đi kèm..."
        aria-invalid="<%= errors.description ? 'true' : 'false' %>"
        aria-describedby="descriptionError"
        data-description-input
        required
      ><%= oldInput.description %></textarea>
      <div class="invalid-feedback" id="descriptionError"><%= errors.description || '' %></div>
    </div>
  </section>

  <div class="listing-editor-actions">
    <a class="btn listing-editor-cancel" href="<%= cancelUrl %>">Hủy</a>
    <button class="btn listing-editor-submit" type="submit" data-listing-submit <%= canSubmit ? '' : 'disabled' %>>
      <%= submitLabel %>
    </button>
  </div>
</form>
