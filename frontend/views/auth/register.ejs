<%- include('../partials/header', {
  pageStyles: ['/css/auth.css']
}) %>

<section
  class="auth-market-page"
  aria-labelledby="registerTitle"
>
  <div class="container auth-market-container">

    <div class="auth-market-layout">

      <!-- ==========================================
           BÊN TRÁI - GIỮ CÙNG ẢNH LOGIN
           ========================================== -->
      <div
        class="auth-market-visual"
        aria-hidden="true"
      >
        <div class="auth-market-orb auth-market-orb--one"></div>
        <div class="auth-market-orb auth-market-orb--two"></div>

        <img
          class="auth-market-visual__image"
          src="/images/auth/auth-marketplace.png"
          alt=""
        >
      </div>


      <!-- ==========================================
           REGISTER
           ========================================== -->
      <div class="auth-market-form-area">

        <div class="auth-market-card">

             <header class="auth-market-header">
            <h1 id="registerTitle">
              Tạo tài khoản
            </h1>
          </header>


          <% if (successMessage) { %>
            <div
              class="alert alert-success"
              role="status"
            >
              <%= successMessage %>
            </div>
          <% } %>


          <% if (errors.general) { %>
            <div
              class="alert alert-danger"
              role="alert"
            >
              <%= errors.general %>
            </div>
          <% } %>


          <form
            class="auth-market-form"
            action="/register"
            method="post"
          >

            <%- include('../partials/csrf') %>


            <!-- NAME -->
            <div class="auth-market-field">

              <label for="name">
                Họ và tên
              </label>

              <div
                class="
                  auth-market-control
                  <%= errors.name ? 'is-invalid' : '' %>
                "
              >

                <span
                  class="auth-market-control__icon"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <circle
                      cx="12"
                      cy="8"
                      r="4"
                      stroke-width="1.8"
                    />

                    <path
                      d="M4 21a8 8 0 0 1 16 0"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>


                <input
                  id="name"
                  name="name"
                  type="text"
                  value="<%= oldInput.name || '' %>"
                  placeholder="Nhập họ và tên"
                  autocomplete="name"
                  minlength="2"
                  maxlength="100"
                  aria-invalid="<%= errors.name ? 'true' : 'false' %>"
                  aria-describedby="registerNameError"
                  required
                >

              </div>

              <div
                class="auth-market-error"
                id="registerNameError"
              >
                <%= errors.name || '' %>
              </div>

            </div>


            <!-- EMAIL -->
            <div class="auth-market-field">

              <label for="email">
                Email
              </label>

              <div
                class="
                  auth-market-control
                  <%= errors.email ? 'is-invalid' : '' %>
                "
              >

                <span
                  class="auth-market-control__icon"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <rect
                      x="3"
                      y="5"
                      width="18"
                      height="14"
                      rx="2"
                      stroke-width="1.8"
                    />

                    <path
                      d="m4 7 8 6 8-6"
                      stroke-width="1.8"
                    />
                  </svg>
                </span>


                <input
                  id="email"
                  name="email"
                  type="email"
                  value="<%= oldInput.email || '' %>"
                  placeholder="Nhập địa chỉ email"
                  autocomplete="email"
                  maxlength="254"
                  aria-invalid="<%= errors.email ? 'true' : 'false' %>"
                  aria-describedby="registerEmailError"
                  required
                >

              </div>

              <div
                class="auth-market-error"
                id="registerEmailError"
              >
                <%= errors.email || '' %>
              </div>

            </div>


            <!-- PASSWORD -->
            <div class="auth-market-field">

              <label for="password">
                Mật khẩu
              </label>

              <div
                class="
                  auth-market-control
                  auth-market-control--password
                  <%= errors.password ? 'is-invalid' : '' %>
                "
              >

                <span
                  class="auth-market-control__icon"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <rect
                      x="5"
                      y="10"
                      width="14"
                      height="10"
                      rx="2"
                      stroke-width="1.8"
                    />

                    <path
                      d="M8 10V7a4 4 0 0 1 8 0v3"
                      stroke-width="1.8"
                    />
                  </svg>
                </span>


                <input
                  id="password"
                  name="password"
                  type="password"
                  placeholder="Tối thiểu 8 ký tự"
                  autocomplete="new-password"
                  minlength="8"
                  maxlength="72"
                  aria-invalid="<%= errors.password ? 'true' : 'false' %>"
                  aria-describedby="registerPasswordError"
                  required
                >


                <button
                  class="auth-password-toggle"
                  type="button"
                  data-password-toggle="password"
                  aria-label="Hiện mật khẩu"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"
                      stroke-width="1.8"
                    />

                    <circle
                      cx="12"
                      cy="12"
                      r="2.5"
                      stroke-width="1.8"
                    />
                  </svg>
                </button>

              </div>


              <div
                class="auth-market-error"
                id="registerPasswordError"
              >
                <%= errors.password || '' %>
              </div>

            </div>


            <!-- CONFIRM PASSWORD -->
            <div class="auth-market-field">

              <label for="confirmPassword">
                Xác nhận mật khẩu
              </label>

              <div
                class="
                  auth-market-control
                  auth-market-control--password
                  <%= errors.confirmPassword ? 'is-invalid' : '' %>
                "
              >

                <span
                  class="auth-market-control__icon"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <rect
                      x="5"
                      y="10"
                      width="14"
                      height="10"
                      rx="2"
                      stroke-width="1.8"
                    />

                    <path
                      d="M8 10V7a4 4 0 0 1 8 0v3"
                      stroke-width="1.8"
                    />
                  </svg>
                </span>


                <input
                  id="confirmPassword"
                  name="confirmPassword"
                  type="password"
                  placeholder="Nhập lại mật khẩu"
                  autocomplete="new-password"
                  minlength="8"
                  maxlength="72"
                  aria-invalid="<%= errors.confirmPassword ? 'true' : 'false' %>"
                  aria-describedby="registerConfirmError"
                  required
                >


                <button
                  class="auth-password-toggle"
                  type="button"
                  data-password-toggle="confirmPassword"
                  aria-label="Hiện mật khẩu"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"
                      stroke-width="1.8"
                    />

                    <circle
                      cx="12"
                      cy="12"
                      r="2.5"
                      stroke-width="1.8"
                    />
                  </svg>
                </button>

              </div>


              <div
                class="auth-market-error"
                id="registerConfirmError"
              >
                <%= errors.confirmPassword || '' %>
              </div>

            </div>


            <button
              class="auth-market-submit"
              type="submit"
            >
              <span>
                Tạo tài khoản
              </span>

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M5 12h14M14 7l5 5-5 5"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

          </form>


          <div class="auth-market-switch">

            <span>
              Đã có tài khoản?
            </span>

            <a href="/login">
              Đăng nhập
            </a>

          </div>


          <a
            class="auth-market-back"
            href="/"
          >
            ← Quay về trang chủ
          </a>

        </div>

      </div>

    </div>

  </div>
</section>

<script
  src="/js/auth.js"
  defer
></script>

<%- include('../partials/footer') %>