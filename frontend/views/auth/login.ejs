<%- include('../partials/header', {
  pageStyles: ['/css/auth.css']
}) %>

<section
  class="auth-market-page"
  aria-labelledby="loginTitle"
>
  <div class="container auth-market-container">

    <div class="auth-market-layout">

      <!-- ==========================================
           BÊN TRÁI - CHỈ HÌNH ẢNH
           ========================================== -->
      <div
        class="auth-market-visual"
        aria-hidden="true"
      >
        <div class="auth-market-orb auth-market-orb--one"></div>
        <div class="auth-market-orb auth-market-orb--two"></div>

        <img
          class="auth-market-visual__image"
          src="/images/auth/auth-marketplace.png"
          alt=""
        >
      </div>


      <!-- ==========================================
           FORM ĐĂNG NHẬP
           ========================================== -->
      <div class="auth-market-form-area">

        <div class="auth-market-card">

          <!-- HEADER -->
          <header class="auth-market-header">

            <h1 id="loginTitle">
              Đăng nhập
            </h1>
          </header>


          <!-- THÔNG BÁO -->
          <% if (successMessage) { %>
            <div
              class="alert alert-success"
              role="status"
            >
              <%= successMessage %>
            </div>
          <% } %>


          <% if (infoMessage) { %>
            <div
              class="alert alert-info"
              role="status"
            >
              <%= infoMessage %>
            </div>
          <% } %>


          <% if (errors.general) { %>
            <div
              class="alert alert-danger"
              role="alert"
            >
              <%= errors.general %>
            </div>
          <% } %>


          <!-- FORM -->
          <form
            class="auth-market-form"
            action="/login"
            method="post"
          >

            <%- include('../partials/csrf') %>


            <!-- EMAIL -->
            <div class="auth-market-field">

              <label for="email">
                Email
              </label>

              <div
                class="
                  auth-market-control
                  <%= errors.email ? 'is-invalid' : '' %>
                "
              >

                <span
                  class="auth-market-control__icon"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <rect
                      x="3"
                      y="5"
                      width="18"
                      height="14"
                      rx="2"
                      stroke-width="1.8"
                    />

                    <path
                      d="m4 7 8 6 8-6"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>


                <input
                  id="email"
                  name="email"
                  type="email"
                  value="<%= oldInput.email || '' %>"
                  placeholder="Nhập địa chỉ email"
                  autocomplete="email"
                  maxlength="254"
                  aria-invalid="<%= errors.email ? 'true' : 'false' %>"
                  aria-describedby="loginEmailError"
                  required
                >

              </div>


              <div
                class="auth-market-error"
                id="loginEmailError"
              >
                <%= errors.email || '' %>
              </div>

            </div>


            <!-- PASSWORD -->
            <div class="auth-market-field">

              <label for="password">
                Mật khẩu
              </label>

              <div
                class="
                  auth-market-control
                  auth-market-control--password
                  <%= errors.password ? 'is-invalid' : '' %>
                "
              >

                <span
                  class="auth-market-control__icon"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <rect
                      x="5"
                      y="10"
                      width="14"
                      height="10"
                      rx="2"
                      stroke-width="1.8"
                    />

                    <path
                      d="M8 10V7a4 4 0 0 1 8 0v3"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>


                <input
                  id="password"
                  name="password"
                  type="password"
                  placeholder="Nhập mật khẩu"
                  autocomplete="current-password"
                  maxlength="72"
                  aria-invalid="<%= errors.password ? 'true' : 'false' %>"
                  aria-describedby="loginPasswordError"
                  required
                >


                <button
                  class="auth-password-toggle"
                  type="button"
                  data-password-toggle="password"
                  aria-label="Hiện mật khẩu"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"
                      stroke-width="1.8"
                    />

                    <circle
                      cx="12"
                      cy="12"
                      r="2.5"
                      stroke-width="1.8"
                    />
                  </svg>
                </button>

              </div>


              <div
                class="auth-market-error"
                id="loginPasswordError"
              >
                <%= errors.password || '' %>
              </div>

            </div>


            <button
              class="auth-market-submit"
              type="submit"
            >
              <span>
                Đăng nhập
              </span>

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M5 12h14M14 7l5 5-5 5"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

          </form>
          <!-- ĐĂNG NHẬP GOOGLE -->
          <div class="auth-market-divider">
            <span>HOẶC</span>
          </div>

          <a class="auth-google-btn" href="/auth/google">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#EA4335" d="M12 11v3h7c-.3 1.6-1.2 3-2.5 3.9l2 1.6C20.5 17.7 21.5 15.1 21.5 12c0-.7-.1-1.3-.2-2H12Z"/>
              <path fill="#34A853" d="M12 21c2.4 0 4.4-.8 5.9-2.2l-2-1.6c-.9.6-2 .9-3.9.9-3 0-5.5-2-6.4-4.8l-2.1 1.6C5 18.5 8.2 21 12 21Z"/>
              <path fill="#FBBC05" d="M5.6 13.3A6.8 6.8 0 0 1 5.2 12c0-.5.1-.9.2-1.3L3.3 9.1A9.5 9.5 0 0 0 2.5 12c0 1 .2 2 .8 2.9l2.3-1.6Z"/>
              <path fill="#4285F4" d="M12 5.8c1.3 0 2.5.5 3.4 1.3l2.5-2.5C16.4 3.2 14.4 2.5 12 2.5 8.2 2.5 5 5 3.3 9.1l2.1 1.6c.9-2.8 3.4-4.9 6.6-4.9Z"/>
            </svg>

            <span>Tiếp tục với Google</span>
          </a>

          <div class="auth-market-switch">
            <span>
              Chưa có tài khoản?
            </span>

            <a href="/register">
              Đăng ký ngay
            </a>
          </div>


          <a
            class="auth-market-back"
            href="/"
          >
            ← Quay về trang chủ
          </a>

        </div>

      </div>

    </div>

  </div>
</section>

<script
  src="/js/auth.js"
  defer
></script>

<%- include('../partials/footer') %>