<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

    <meta
      name="description"
      content="NTT Marketplace - Nền tảng mua bán và đăng tin sản phẩm cũ."
    >

    <title><%= pageTitle %> | <%= siteName %></title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/style.css">

    <% if (typeof pageStyles !== 'undefined' && Array.isArray(pageStyles)) { %>
      <% pageStyles.forEach((stylePath) => { %>
        <link rel="stylesheet" href="<%= stylePath %>">
      <% }); %>
    <% } %>
  </head>

  <body>

    <header class="site-header sticky-top">

      <!-- =========================
           HEADER TẦNG 1
           ========================= -->
      <nav
        class="navbar navbar-expand-xl site-navbar"
        aria-label="Điều hướng chính"
      >
        <div class="container site-navbar-inner">

          <!-- LOGO -->
          <a
            class="navbar-brand site-wordmark"
            href="/"
            aria-label="NTT Marketplace — Trang chủ"
          >
            <span class="site-wordmark__ntt">NTT</span>
            <span class="site-wordmark__marketplace">Marketplace</span>
          </a>

          <!-- TÌM KIẾM -->
          <form
            class="site-global-search"
            method="GET"
            action="/listings"
            role="search"
          >
            <label
              class="visually-hidden"
              for="globalKeyword"
            >
              Tìm sản phẩm
            </label>

            <input
              class="site-global-search__input"
              id="globalKeyword"
              name="keyword"
              type="search"
              maxlength="100"
              placeholder="Tìm kiếm sản phẩm, dịch vụ..."
              autocomplete="off"
            >

            <button
              class="site-global-search__button"
              type="submit"
              aria-label="Tìm kiếm"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-4-4"></path>
              </svg>

              <span>Tìm kiếm</span>
            </button>
          </form>

          <!-- MENU MOBILE -->
          <button
            class="navbar-toggler site-navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavigation"
            aria-controls="mainNavigation"
            aria-expanded="false"
            aria-label="Mở điều hướng"
          >
            <span class="navbar-toggler-icon"></span>
          </button>

          <!-- ACTION -->
          <div
            class="collapse navbar-collapse"
            id="mainNavigation"
          >
            <ul
              class="navbar-nav site-nav-account align-items-xl-center ms-xl-auto"
            >

              <% if (isAuthenticated) { %>

                <!-- ADMIN -->
                <% if (currentUser.role === 'admin') { %>
                  <li class="nav-item">
                    <a
                      class="nav-link site-admin-link"
                      href="/admin"
                    >
                      Quản trị
                    </a>
                  </li>
                <% } %>

                <!-- YÊU THÍCH -->
                <li class="nav-item site-icon-nav-item">
                  <a
                    class="nav-link site-icon-link"
                    href="/favorites"
                    aria-label="Tin đã lưu"
                    title="Tin đã lưu"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      aria-hidden="true"
                    >
                      <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"
                      ></path>
                    </svg>

                    <span class="site-mobile-nav-label">
                      Tin đã lưu
                    </span>
                  </a>
                </li>

                <!-- TIN NHẮN -->
                <li class="nav-item site-icon-nav-item">
                  <a
                    class="nav-link site-icon-link nav-messages-link"
                    href="/messages"
                    aria-label="Tin nhắn<%= unreadMessageCount > 0 ? `, ${unreadMessageCount > 99 ? 'trên 99' : unreadMessageCount} tin chưa đọc` : '' %>"
                    title="Tin nhắn"
                  >

                    <span class="site-icon-link__icon-wrap">

                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <path
                          d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"
                        ></path>
                      </svg>

                      <% if (unreadMessageCount > 0) { %>
                        <span
                          class="nav-unread-badge"
                          aria-hidden="true"
                        >
                          <%= unreadMessageCount > 99 ? '99+' : unreadMessageCount %>
                        </span>
                      <% } %>

                    </span>

                    <span class="site-mobile-nav-label">
                      Tin nhắn
                    </span>

                  </a>
                </li>

                <!-- PROFILE -->
                <li class="nav-item dropdown">
                  <button
                    class="nav-link nav-profile-link dropdown-toggle border-0 bg-transparent"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                  >
                    <img
                      class="header-avatar"
                      src="<%= currentUser.avatarUrl %>"
                      alt="Ảnh đại diện của <%= currentUser.name %>"
                      width="32"
                      height="32"
                    >

                    <span class="nav-profile-copy">
                      <span>Hồ sơ</span>
                      <span class="nav-user-name"><%= currentUser.name %></span>
                    </span>
                  </button>

                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <a class="dropdown-item" href="/profile">
                        Hồ sơ cá nhân
                      </a>
                    </li>

                    <li>
                      <hr class="dropdown-divider">
                    </li>

                    <li>
                      <form method="POST" action="/logout">
                        <%- include('csrf') %>

                        <button
                          class="dropdown-item text-danger"
                          type="submit"
                        >
                          Đăng xuất
                        </button>
                      </form>
                    </li>
                  </ul>
                </li>
              <% } else { %>

                <li class="nav-item">
                  <a
                    class="nav-link site-login-link"
                    href="/login"
                  >
                    Đăng nhập
                  </a>
                </li>

                <li class="nav-item">
                  <a
                    class="btn btn-outline-primary site-nav-button"
                    href="/register"
                  >
                    Đăng ký
                  </a>
                </li>

              <% } %>

              <!-- ĐĂNG TIN -->
              <li class="nav-item">
                <a
                  class="btn btn-primary site-nav-button site-post-button"
                  href="<%= isAuthenticated ? '/listings/create' : '/login' %>"
                >

                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v8M8 12h8"></path>
                  </svg>

                  <span>Đăng tin</span>

                </a>
              </li>

            </ul>
          </div>

        </div>
      </nav>

    </header>

    <main>