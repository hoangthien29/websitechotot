<% const categoryIconSlug = String(category && category.slug ? category.slug : '').trim().toLowerCase(); %>
<svg
  class="category-card__icon-svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <% if (categoryIconSlug === 'dien-thoai') { %>
    <rect x="7" y="2" width="10" height="20" rx="2"></rect>
    <path d="M10 18h4"></path>
  <% } else if (categoryIconSlug === 'laptop-va-may-tinh') { %>
    <rect x="4" y="4" width="16" height="12" rx="1.5"></rect>
    <path d="M2 19h20"></path>
    <path d="M9 19h6"></path>
  <% } else if (categoryIconSlug === 'xe-may') { %>
    <circle cx="6" cy="17" r="3"></circle>
    <circle cx="18" cy="17" r="3"></circle>
    <path d="M6 17l4-7h4l4 7"></path>
    <path d="M10 10 8 7h3"></path>
    <path d="M13 7h4l2 3"></path>
    <path d="M10 17h4"></path>
  <% } else if (categoryIconSlug === 'do-dien-tu') { %>
    <rect x="6" y="6" width="12" height="12" rx="2"></rect>
    <rect x="9" y="9" width="6" height="6" rx="1"></rect>
    <path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"></path>
  <% } else if (categoryIconSlug === 'do-gia-dung') { %>
    <path d="M3 11 12 3l9 8"></path>
    <path d="M5 10v10h14V10"></path>
    <path d="M9 20v-6h6v6"></path>
  <% } else if (categoryIconSlug === 'thoi-trang') { %>
    <path d="m8 4 4 2 4-2 4 3-3 2v11H7V9L4 7l4-3Z"></path>
    <path d="M10 5.2a2.2 2.2 0 0 0 4 0"></path>
  <% } else if (categoryIconSlug === 'noi-that') { %>
    <path d="M5 12V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4"></path>
    <path d="M4 11a2 2 0 0 0-2 2v5h20v-5a2 2 0 0 0-2-2"></path>
    <path d="M6 18v2M18 18v2M12 12v6"></path>
  <% } else if (categoryIconSlug === 'the-thao') { %>
    <circle cx="12" cy="12" r="9"></circle>
    <path d="m8.5 4.8 2.2 3.1-1.4 4.2-3.8 1.2"></path>
    <path d="m15.5 4.8-2.2 3.1 1.4 4.2 3.8 1.2"></path>
    <path d="m9.3 12.1 2.7 2 2.7-2"></path>
    <path d="m8.2 20 3.8-5.9 3.8 5.9"></path>
  <% } else if (categoryIconSlug === 'me-va-be') { %>
    <circle cx="8" cy="19" r="2"></circle>
    <circle cx="18" cy="19" r="2"></circle>
    <path d="M4 5h3l2 9h9l2-6H8"></path>
    <path d="M12 4a3 3 0 0 1 3 3v1H9V7a3 3 0 0 1 3-3Z"></path>
  <% } else if (categoryIconSlug === 'khac') { %>
    <circle cx="5" cy="12" r="1.5"></circle>
    <circle cx="12" cy="12" r="1.5"></circle>
    <circle cx="19" cy="12" r="1.5"></circle>
  <% } else { %>
    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
  <% } %>
</svg>
