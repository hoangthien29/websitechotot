<%- include('../partials/header', {
  pageStyles: ['/css/profile.css']
}) %>

<section
  class="profile-page"
  aria-labelledby="profile-title"
>

  <div class="container">


    <% if (successMessage) { %>

      <div
        class="alert alert-success profile-alert"
        role="status"
      >
        <%= successMessage %>
      </div>

    <% } %>


    <!-- =====================================================
         HỒ SƠ CHÍNH
         ===================================================== -->

    <section class="profile-overview">

      <div class="profile-overview__main">


        <!-- AVATAR -->

        <div class="profile-avatar-wrap">

          <img
            class="profile-main-avatar"
            src="<%= profileUser.avatarUrl %>"
            alt="Ảnh đại diện của <%= profileUser.name %>"
            width="128"
            height="128"
          >

        </div>



        <!-- THÔNG TIN -->

        <div class="profile-identity">

          <span class="profile-kicker">
            Hồ sơ cá nhân
          </span>


          <h1 id="profile-title">
            <%= profileUser.name %>
          </h1>


          <p class="profile-email">
            <%= profileUser.email %>
          </p>


          <p class="profile-joined">
            Tham gia từ ngày
            <strong>
              <%= profileUser.formattedCreatedAt %>
            </strong>
          </p>

        </div>

      </div>



      <!-- ACTION -->

      <div class="profile-actions">

        <a
          class="profile-action profile-action--primary"
          href="/profile/edit"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 20h9"></path>

            <path
              d="
                M16.5 3.5
                a2.1 2.1 0 0 1 3 3
                L8 18
                l-4 1
                1-4Z
              "
            ></path>
          </svg>

          <span>
            Chỉnh sửa hồ sơ
          </span>

        </a>


        <a
          class="profile-action"
          href="/listings/create"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 5v14"></path>
            <path d="M5 12h14"></path>
          </svg>

          <span>
            Đăng tin
          </span>

        </a>


        <a
          class="profile-action"
          href="/my-listings"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect
              x="3"
              y="4"
              width="18"
              height="16"
              rx="3"
            ></rect>

            <path d="M8 9h8"></path>
            <path d="M8 13h5"></path>
          </svg>

          <span>
            Bài đăng của tôi
          </span>

        </a>

      </div>



      <!-- ===================================================
           THÔNG TIN LIÊN HỆ
           =================================================== -->

      <div class="profile-contact-grid">


        <div class="profile-contact-item">

          <span class="profile-contact-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="
                  M22 16.92v3
                  a2 2 0 0 1-2.18 2
                  19.8 19.8 0 0 1-8.63-3.07
                  19.5 19.5 0 0 1-6-6
                  A19.8 19.8 0 0 1 2.12 4.18
                  2 2 0 0 1 4.11 2h3
                  a2 2 0 0 1 2 1.72
                  12.8 12.8 0 0 0 .7 2.81
                  2 2 0 0 1-.45 2.11
                  L8.09 9.91
                  a16 16 0 0 0 6 6
                  l1.27-1.27
                  a2 2 0 0 1 2.11-.45
                  12.8 12.8 0 0 0 2.81.7
                  A2 2 0 0 1 22 16.92Z
                "
              ></path>
            </svg>

          </span>


          <div>

            <span>
              Số điện thoại
            </span>

            <strong>
              <%= profileUser.phone || 'Chưa cập nhật' %>
            </strong>

          </div>

        </div>



        <div class="profile-contact-item">

          <span class="profile-contact-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="
                  M20 10
                  c0 5-8 11-8 11
                  S4 15 4 10
                  a8 8 0 1 1 16 0Z
                "
              ></path>

              <circle
                cx="12"
                cy="10"
                r="2.5"
              ></circle>
            </svg>

          </span>


          <div>

            <span>
              Địa chỉ
            </span>

            <strong>
              <%= profileUser.address || 'Chưa cập nhật' %>
            </strong>

          </div>

        </div>


      </div>

    </section>



    <!-- =====================================================
         THỐNG KÊ
         ===================================================== -->

    <section
      class="profile-stats"
      aria-label="Thống kê bài đăng"
    >


      <article class="profile-stat profile-stat--total">

        <span>
          Tổng bài đăng
        </span>

        <strong data-stat="total">
          <%= stats.totalListings %>
        </strong>

      </article>



      <article class="profile-stat profile-stat--active">

        <span>
          Đang bán
        </span>

        <strong data-stat="active">
          <%= stats.activeListings %>
        </strong>

      </article>



      <article class="profile-stat profile-stat--sold">

        <span>
          Đã bán
        </span>

        <strong data-stat="sold">
          <%= stats.soldListings %>
        </strong>

      </article>



      <article class="profile-stat profile-stat--hidden">

        <span>
          Đã ẩn
        </span>

        <strong data-stat="hidden">
          <%= stats.hiddenListings %>
        </strong>

      </article>


    </section>



    <!-- =====================================================
         BÀI ĐĂNG GẦN ĐÂY
         ===================================================== -->

    <section class="profile-recent">

      <header class="profile-section-header">

        <div>

          <span class="profile-section-kicker">
            Hoạt động gần đây
          </span>

          <h2>
            Bài đăng mới nhất
          </h2>

          <p>
            Theo dõi nhanh trạng thái các tin bạn vừa đăng.
          </p>

        </div>


        <a
          class="profile-view-all"
          href="/my-listings"
        >
          Xem tất cả

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6"></path>
          </svg>

        </a>

      </header>



      <% if (recentListings.length > 0) { %>

        <div class="profile-recent-grid">

          <% recentListings.forEach((listing) => { %>

            <div
              class="profile-recent-item"
              data-recent-listing="<%= listing._id %>"
            >

              <%- include(
                '../listings/_card',
                {
                  listing
                }
              ) %>

            </div>

          <% }); %>

        </div>


      <% } else { %>

        <div
          class="profile-empty"
          role="status"
        >

          <div class="profile-empty__icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect
                x="3"
                y="4"
                width="18"
                height="16"
                rx="3"
              ></rect>

              <path d="M8 9h8"></path>
              <path d="M8 13h5"></path>
            </svg>

          </div>


          <h3>
            Bạn chưa có bài đăng nào
          </h3>


          <p>
            Đăng sản phẩm đầu tiên để bắt đầu kết nối
            với người mua.
          </p>


          <a
            class="profile-empty-button"
            href="/listings/create"
          >
            Đăng tin đầu tiên
          </a>

        </div>

      <% } %>

    </section>

  </div>

</section>


<%- include('../partials/footer') %>